<Project>

    <PropertyGroup>
        <Company>codeworx gmbh</Company>
        <Copyright>copyright © codeworx 2020</Copyright>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisRuleSet>..\..\global\StyleCop.ruleset</CodeAnalysisRuleSet>
        <DebugType>portable</DebugType>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>
    <PropertyGroup>
        <DotNetTargetFrameworks>net8;net9;net10.0</DotNetTargetFrameworks>
        <FullAndCoreTargetFrameworks>net462;net8;net9;net10.0</FullAndCoreTargetFrameworks>
        <NetStandardTargetFrameworks>netstandard2.0</NetStandardTargetFrameworks>
    </PropertyGroup>
    <PropertyGroup>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>2.0.19</PackageValidationBaselineVersion>
    </PropertyGroup>
    <ItemGroup>
        <AdditionalFiles Include="..\..\global\stylecop.json" Link="stylecop.json" />
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <CodeAnalysisRuleSet>..\..\global\StyleCop.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>

</Project>