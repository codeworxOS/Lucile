<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6;net8;net9</TargetFrameworks>
		<Description>Entity Framework Core components for the Lucile Framework. For detailed Documentation visit http://www.github.com/codeworxOS/Lucile</Description>
		<AssemblyTitle>Lucile Framework Entity Framework Core Library</AssemblyTitle>
		<Configurations>Debug;Release;Debug EF60;Debug EF80;Debug EF90</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EfVersion)' == '6'">
		<TargetFrameworks>net6</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup Condition="'$(EfVersion)' == '8'">
		<TargetFrameworks>net8</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup Condition="'$(EfVersion)' == '9'">
		<TargetFrameworks>net8</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug EF60'">
		<TargetFrameworks>net6</TargetFrameworks>	
		<EfVersion>6</EfVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug EF80'">
		<TargetFrameworks>net8</TargetFrameworks>
		<EfVersion>8</EfVersion>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)'=='Debug EF90'">
	  <TargetFrameworks>net8</TargetFrameworks>
	  <EfVersion>9</EfVersion>
	</PropertyGroup>


	<PropertyGroup Condition="'$(EfVersion)' == '' And '$(TargetFramework)' == 'net6'">
		<EfVersion>6</EfVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(EfVersion)' == '' And '$(TargetFramework)' == 'net8'">
		<EfVersion>8</EfVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(EfVersion)' == '' And '$(TargetFramework)' == 'net9'">
		<EfVersion>9</EfVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EfVersion)' == '6'">
		<DefineConstants>EF6</DefineConstants>
		<PackageValidationBaselineVersion>2.6000.0</PackageValidationBaselineVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(EfVersion)' == '8'">
		<DefineConstants>EF8</DefineConstants>
		<PackageValidationBaselineVersion>2.8000.0</PackageValidationBaselineVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(EfVersion)' == '9'">
		<DefineConstants>EF9</DefineConstants>
		<PackageValidationBaselineVersion>2.9000.0</PackageValidationBaselineVersion>
	</PropertyGroup>



	<ItemGroup Condition="'$(EfVersion)' == '6'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.36" />
	</ItemGroup>
	<ItemGroup Condition="'$(EfVersion)' == '8'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
	</ItemGroup>
	<ItemGroup Condition="'$(EfVersion)' == '9'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lucile.Core\Lucile.Core.csproj" />
	</ItemGroup>
</Project>